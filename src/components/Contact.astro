---
import { profile, contactLinks } from '../data/profile';
import ContactLink from './ContactLink.astro';
---

<section class="section container contact" id="contact" aria-labelledby="contact-heading">
  <span class="eyebrow">Contact</span>
  <h2 class="contact__title" id="contact-heading">Let's talk</h2>
  <p class="contact__text">{profile.contactNote}</p>

  <div class="contact__links">
    {contactLinks.map((link) => <ContactLink link={link} />)}
  </div>
</section>
