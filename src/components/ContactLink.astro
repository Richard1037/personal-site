---
import type { Link } from '../data/profile';

/**
 * 一个联系方式按钮。
 *
 * - 有 url：渲染为 <a>，可点击跳转
 * - 没有 url（例如微信号）：渲染为 <span>，不可点击，但可键盘聚焦以显示提示
 * - 带 hint：鼠标悬停或键盘聚焦时在按钮上方显示具体内容
 */
interface Props {
  link: Link;
  /** 'primary' 渲染为实心主按钮，用于首屏的第一个联系方式。 */
  variant?: 'primary' | 'default';
}

const { link, variant = 'default' } = Astro.props;

const isExternal = link.url.startsWith('http');
const classes = ['button', variant === 'primary' && 'button--primary', !link.url && 'button--static'];
---

{
  link.url ? (
    <a
      class:list={classes}
      href={link.url}
      rel={isExternal ? 'me noopener' : undefined}
      target={isExternal ? '_blank' : undefined}
    >
      {link.label}
      {link.hint && (
        <span class="tooltip" aria-hidden="true">
          {link.hint}
        </span>
      )}
    </a>
  ) : (
    <span
      class:list={classes}
      tabindex="0"
      aria-label={link.hint ? `${link.label}: ${link.hint}` : link.label}
    >
      {link.label}
      {link.hint && (
        <span class="tooltip" aria-hidden="true">
          {link.hint}
        </span>
      )}
    </span>
  )
}
