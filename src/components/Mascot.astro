---
/**
 * 奶龙。
 *
 * 手写的内联 SVG：零外部请求、可随主题缩放、只有两条 CSS 动画。
 *
 * 一个设计取舍值得说明：参考图里手臂是靠 3D 阴影区分的，轮廓上几乎不凸。
 * 如果把它画成凸出轮廓的手臂，侧面就会出现肿块、整体不像。所以这里用
 * **略深一档的色块**在轮廓内部表现手臂——这是平面插画还原立体角色的常规做法。
 *
 * 想换掉它：删掉 Hero.astro 里的 <Mascot /> 一行即可。
 */
---

<svg
  class="mascot"
  viewBox="0 0 120 175"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- 腿 -->
  <ellipse cx="42" cy="150" rx="12" ry="14" fill="#f0e2a0"></ellipse>
  <ellipse cx="78" cy="150" rx="12" ry="14" fill="#f0e2a0"></ellipse>

  <!-- 身体：光滑的蛋形，头身一体 -->
  <path
    d="M60 4C74 4 83 15 85 32C87 55 106 72 109 96C111 118 100 140 86 148C78 153 70 156 60 156C50 156 42 153 34 148C20 140 9 118 11 96C14 72 33 55 35 32C37 15 46 4 60 4Z"
    fill="#f0e2a0"></path>

  <!-- 左臂 -->
  <path
    d="M24 80C17 96 19 110 27 117"
    fill="none"
    stroke="#e4d48f"
    stroke-width="13"
    stroke-linecap="round"></path>

  <!-- 右臂：颜色还是略深，靠 CSS 轻微摆动 -->
  <g class="mascot__arm">
    <path
      d="M96 80C103 96 101 110 93 117"
      fill="none"
      stroke="#e4d48f"
      stroke-width="13"
      stroke-linecap="round"></path>
  </g>

  <!-- 眼睛：深色小椭圆 + 高光 -->
  <ellipse cx="43" cy="41" rx="7.5" ry="9" fill="#3a3a32"></ellipse>
  <ellipse cx="77" cy="41" rx="7.5" ry="9" fill="#3a3a32"></ellipse>
  <circle cx="45" cy="37.6" r="1.9" fill="#ffffff"></circle>
  <circle cx="79" cy="37.6" r="1.9" fill="#ffffff"></circle>

  <!-- 嘴：很小 -->
  <path
    d="M55 58C57 62 63 62 65 58"
    fill="none"
    stroke="#6e6033"
    stroke-width="2"
    stroke-linecap="round"></path>
</svg>
