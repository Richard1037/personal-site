---
import { now } from '../data/profile';

const hasLinks = now.links.length > 0;
---

<section class="section container" id="now" aria-labelledby="now-heading">
  <span class="eyebrow">Now</span>
  <h2 class="section__title" id="now-heading">
    What I'm up to
    <span class="now__updated">{now.updated}</span>
  </h2>

  <div class="now__body">
    {now.body.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  {
    hasLinks && (
      <div class="now__links">
        {now.links.map((link) => (
          <a class="link-arrow" href={link.url} target="_blank" rel="noopener">
            {link.label}
          </a>
        ))}
      </div>
    )
  }
</section>
