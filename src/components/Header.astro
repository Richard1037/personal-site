---
import { profile, sections } from '../data/profile';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="#top">{profile.name}</a>

    <div class="site-header__end">
      <nav class="site-nav" aria-label="Main">
        {
          sections.map((section) => (
            <a href={`#${section.id}`}>{section.label}</a>
          ))
        }
      </nav>

      <!--
        Hidden by default and revealed by the inline script in BaseLayout, so
        it is never shown as a dead control when JavaScript is unavailable.
        The icon shown is the theme you would switch TO.
      -->
      <button
        class="theme-toggle"
        type="button"
        id="theme-toggle"
        aria-label="Switch between light and dark theme"
        title="Switch theme"
      >
        <svg
          class="theme-toggle__sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>

        <svg
          class="theme-toggle__moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
