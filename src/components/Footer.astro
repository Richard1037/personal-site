---
import { profile } from '../data/profile';

// Shows a single year until the site has survived into a second one.
const year = new Date().getFullYear();
const copyright = profile.since < year ? `${profile.since}–${year}` : `${year}`;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <span>© {copyright} {profile.name}</span>
    <span>Last updated {profile.lastUpdated} · Built with Astro</span>
  </div>
</footer>
