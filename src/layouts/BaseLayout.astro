---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile, siteDescription } from '../data/profile';

interface Props {
  /** Browser tab / search-result title. Defaults to name + headline. */
  title?: string;
}

const { title = `${profile.name} · ${profile.headline}` } = Astro.props;

// Canonical URL for SEO. `Astro.site` comes from `site` in astro.config.mjs —
// remember to change it there once you own a domain.
const site = Astro.site ?? new URL('https://your-domain.com');
const canonical = new URL(Astro.url.pathname, site).href;
const description = siteDescription;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Link previews on Twitter/X, LinkedIn, WeChat, Slack, etc. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Tints the browser UI (mobile address bar) to match the theme. The
         inline script below keeps this in step with the toggle. -->
    <meta name="theme-color" content="#ffffff" id="theme-color" />

    <!--
      Applies the stored theme before the first paint, so there is never a flash
      of the wrong colours. This inline script is the only reason the site needs
      any JavaScript at all; with scripts disabled everything else still works,
      and the stylesheet falls back to the OS colour-scheme preference.
    -->
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {
          /* Some privacy modes throw on localStorage access. */
        }

        var prefersDark =
          window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme =
          stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light';

        document.documentElement.setAttribute('data-theme', theme);
        // Reveals the theme toggle, which stays hidden without JavaScript.
        document.documentElement.classList.add('js');

        var meta = document.getElementById('theme-color');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#0e1013' : '#ffffff');
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      (function () {
        var button = document.getElementById('theme-toggle');
        if (!button) return;

        button.addEventListener('click', function () {
          var root = document.documentElement;
          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';

          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (e) {
            /* Ignore - the choice simply will not persist. */
          }

          var meta = document.getElementById('theme-color');
          if (meta) meta.setAttribute('content', next === 'dark' ? '#0e1013' : '#ffffff');
        });
      })();
    </script>
  </body>
</html>
